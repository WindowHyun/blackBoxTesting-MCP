{
  "name": "saucedemo-problem-user",
  "description": "happy-path와 동일한 단언을 problem_user로 실행한다. 이 계정에는 결함이 의도적으로 심겨 있으므로 일부 스텝이 실패해야 정상이며, 그 실패 지점이 곧 도구의 탐지 능력이다. --continue-on-fail 필수(첫 실패에서 멈추면 나머지 결함을 못 본다).",
  "steps": [
    {
      "action": "navigate",
      "url": "https://www.saucedemo.com/",
      "expect_status": 200,
      "tag": "REQ-LOGIN-01"
    },
    {
      "action": "interact",
      "type": "type",
      "selector": "#user-name",
      "value": "problem_user",
      "tag": "REQ-LOGIN-02"
    },
    {
      "action": "interact",
      "type": "type",
      "selector": "#password",
      "value": "${SAUCE_PASSWORD}",
      "tag": "REQ-LOGIN-02"
    },
    {
      "action": "interact",
      "type": "click",
      "selector": "#login-button",
      "tag": "REQ-LOGIN-02"
    },
    {
      "action": "assert",
      "kind": "url_contains",
      "target": "inventory.html",
      "tag": "REQ-LOGIN-02",
      "priority": "high"
    },
    {
      "action": "assert",
      "kind": "count",
      "target": ".inventory_item",
      "expected": "6",
      "tag": "REQ-CATALOG-01"
    },
    {
      "action": "snapshot",
      "mode": "dom",
      "focus": ".inventory_list",
      "tag": "REQ-CATALOG-03"
    },
    {
      "action": "interact",
      "type": "select",
      "selector": "[data-test=\"product_sort_container\"]",
      "value": "Price (low to high)",
      "tag": "REQ-CATALOG-02",
      "priority": "medium"
    },
    {
      "action": "interact",
      "type": "click",
      "selector": "#add-to-cart-sauce-labs-backpack",
      "tag": "REQ-CART-01",
      "priority": "high"
    },
    {
      "action": "assert",
      "kind": "element_visible",
      "target": ".shopping_cart_badge",
      "tag": "REQ-CART-01"
    },
    {
      "action": "interact",
      "type": "click",
      "selector": ".shopping_cart_link",
      "tag": "REQ-CART-02"
    },
    {
      "action": "assert",
      "kind": "count",
      "target": ".cart_item",
      "expected": "1",
      "tag": "REQ-CART-02",
      "priority": "high"
    },
    {
      "action": "interact",
      "type": "click",
      "selector": "#checkout",
      "tag": "REQ-CHECKOUT-01"
    },
    {
      "action": "interact",
      "type": "type",
      "selector": "#first-name",
      "value": "길동",
      "tag": "REQ-CHECKOUT-01"
    },
    {
      "action": "interact",
      "type": "type",
      "selector": "#last-name",
      "value": "홍",
      "tag": "REQ-CHECKOUT-01",
      "priority": "high"
    },
    {
      "action": "interact",
      "type": "type",
      "selector": "#postal-code",
      "value": "06236",
      "tag": "REQ-CHECKOUT-01"
    },
    {
      "action": "interact",
      "type": "click",
      "selector": "#continue",
      "tag": "REQ-CHECKOUT-01"
    },
    {
      "action": "assert",
      "kind": "url_contains",
      "target": "checkout-step-two.html",
      "tag": "REQ-CHECKOUT-02",
      "priority": "high"
    },
    {
      "action": "interact",
      "type": "click",
      "selector": "#finish",
      "tag": "REQ-CHECKOUT-03"
    },
    {
      "action": "assert",
      "kind": "text_visible",
      "target": "Thank you for your order!",
      "tag": "REQ-CHECKOUT-03",
      "priority": "high"
    }
  ]
}
